#!/usr/bin/env bash
# AppRun / wine wrapper for the CentOS-7-native wine AppImage.
# 布局：wine 二进制在 $APPDIR/usr/bin/wine，bundled lib 在 $APPDIR/usr/lib64 与 $APPDIR/usr/lib。
# 系统 glibc 必须由系统提供（CentOS 7 上是 2.17）；本 AppImage 不带 glibc。

# Per-user state dir
progHome="${XDG_CACHE_HOME:-$HOME/.cache}/wine-appimage-staging"
mkdir -p "$progHome" 2>/dev/null

# ── 递归保护：wine/wineserver 子进程会再次走到 AppImage 入口 ────────────
if [ "${__WINE_APPIMAGE_ACTIVE:-0}" = "1" ] && [ -x "$APPDIR/usr/bin/wine" ] ; then
    exec "$APPDIR/usr/bin/wine" "$@"
fi
export __WINE_APPIMAGE_ACTIVE=1

# ── wine 环境 ─────────────────────────────────────────────────────────────
export WINE="$APPDIR/usr/bin/wine"
export WINESERVER="$APPDIR/usr/bin/wineserver"
export WINELOADER="$APPDIR/usr/bin/wine"
export WINEDEBUG=${WINEDEBUG:-"fixme-all"}
export WINEPREFIX=${WINEPREFIX:-"$HOME/.wine-appimage-staging"}
# wine 内部用 WINEDLLPATH 查 PE loader（.so）；64 + 32 都列上
export WINEDLLPATH="$APPDIR/usr/lib64/wine:$APPDIR/usr/lib/wine${WINEDLLPATH:+:$WINEDLLPATH}"
# bundled 依赖（freetype/X11/fontconfig 等）。glibc 不在里面，系统 ld 仍会用 /lib64/libc.so.6
export LD_LIBRARY_PATH="$APPDIR/usr/lib64:$APPDIR/usr/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"

# DXVK env（构建时已 --without-vulkan，仅作占位）
export DXVK_LOG_LEVEL=${DXVK_LOG_LEVEL:-"none"}
export DXVK_STATE_CACHE=${DXVK_STATE_CACHE:-"0"}
export DXVK_CONFIG_FILE=${DXVK_CONFIG_FILE:-"$progHome/dxvk.conf"}

# 无参时启动 winecfg
APPLICATION=""
if [ -z "$*" ] ; then
    APPLICATION="winecfg"
fi

# 允许 AppImage 被 symlink 成 wineserver/winecfg 等
if [ -n "${APPIMAGE:-}" ] ; then
    BINARY_NAME=$(basename "$ARGV0")
else
    BINARY_NAME=$(basename "$0")
fi

# 选择实际要 exec 的二进制
if [ -n "${1:-}" ] && [ -e "$APPDIR/usr/bin/$1" ] ; then
    MAIN="$APPDIR/usr/bin/$1" ; shift
elif [ -e "$APPDIR/usr/bin/$BINARY_NAME" ] ; then
    MAIN="$APPDIR/usr/bin/$BINARY_NAME"
else
    MAIN="$APPDIR/usr/bin/wine"
fi

if [ -z "$APPLICATION" ] ; then
    exec "$MAIN" "$@"
else
    exec "$MAIN" "$APPLICATION"
fi
